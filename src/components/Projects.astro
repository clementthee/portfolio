---
import { portfolioData } from '@/data/portfolioData';

const { projects } = portfolioData;
const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<section id="proyectos" class="mb-24 scroll-mt-24">
  <h2 class="section-heading">02 — Proyectos</h2>

  <div class="grid gap-6">
    {
      featuredProjects.map((project) => (
        <article class="group card-surface relative overflow-hidden hover:border-cyan-500/25 hover:shadow-lg hover:shadow-cyan-500/5">
          <!-- Accent glow -->
          <div
            class="pointer-events-none absolute -top-24 -right-24 size-48 rounded-full bg-cyan-500/5 blur-3xl transition-all duration-500 group-hover:bg-cyan-500/10"
            aria-hidden="true"
          />

          <div class="relative p-6 sm:p-8">
            <div class="mb-4 flex items-start justify-between gap-4">
              <div>
                <div class="mb-2 flex items-center gap-2">
                  <span class="font-code text-xs text-cyan-500/60">featured</span>
                  <span class="tech-pill border-emerald-500/20 bg-emerald-500/5 text-emerald-400/90">
                    open source
                  </span>
                </div>
                <h3 class="font-code text-xl font-semibold text-zinc-100 transition-colors group-hover:text-cyan-400 sm:text-2xl">
                  {project.title}
                </h3>
              </div>

              {
                project.repository && (
                  <a
                    href={project.repository}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="icon-btn shrink-0"
                    aria-label={`Ver repositorio de ${project.title} en GitHub`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                      <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  </a>
                )
              }
            </div>

            <p class="mb-6 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">
              {project.description}
            </p>

            <div class="mb-6 flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <span class="tech-pill">{tech}</span>
              ))}
            </div>

            {
              project.repository && (
                <a
                  href={project.repository}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary text-xs sm:text-sm"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                  Ver en GitHub
                </a>
              )
            }
          </div>
        </article>
      ))
    }

    {
      otherProjects.map((project) => (
        <article class="card-surface p-6 sm:p-8">
          <h3 class="mb-2 font-code text-lg font-semibold text-zinc-100">{project.title}</h3>
          <p class="mb-4 text-sm text-zinc-400">{project.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.technologies.map((tech) => (
              <span class="tech-pill">{tech}</span>
            ))}
          </div>
        </article>
      ))
    }

    <!-- WIP state -->
    <div class="card-surface flex items-center gap-4 border-dashed p-6 sm:p-8">
      <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-zinc-500"
          aria-hidden="true"
        >
          <path d="M12 2v4" />
          <path d="m16.2 7.8 2.9-2.9" />
          <path d="M18 12h4" />
          <path d="m16.2 16.2 2.9 2.9" />
          <path d="M12 18v4" />
          <path d="m4.9 19.1 2.9-2.9" />
          <path d="M2 12h4" />
          <path d="m4.9 4.9 2.9 2.9" />
        </svg>
      </div>
      <div>
        <p class="font-code text-sm text-zinc-400">Work in progress</p>
        <p class="text-xs text-zinc-600">Más proyectos en camino — stay tuned.</p>
      </div>
    </div>
  </div>
</section>
