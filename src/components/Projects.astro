---
import { portfolioData } from '@/data/portfolioData';

const { projects } = portfolioData;
const featuredProject = projects.find((p) => p.featured) ?? projects[0];
---

<section id="proyectos" class="mb-24 scroll-mt-24">
  <h2 class="section-heading">02 — Proyectos</h2>

  <div class="grid gap-6">
    {
      featuredProject && (
        <article class="group card-surface relative overflow-hidden border-violet-500/15 hover:border-violet-500/30 hover:shadow-lg hover:shadow-violet-500/5">
          <div
            class="pointer-events-none absolute -top-24 -right-24 size-56 rounded-full bg-violet-500/5 blur-3xl transition-all duration-500 group-hover:bg-violet-500/10"
            aria-hidden="true"
          />

          <div class="relative p-6 sm:p-8">
            <div class="mb-4 flex items-start justify-between gap-4">
              <div>
                <div class="mb-3 flex flex-wrap items-center gap-2">
                  <span class="font-code text-xs text-violet-400/80">🏆 hackathon project</span>
                  {
                    featuredProject.hackathon && (
                      <span class="inline-flex items-center rounded-full border border-violet-500/25 bg-violet-500/10 px-2.5 py-0.5 font-mono text-xs text-violet-300">
                        {featuredProject.hackathon}
                      </span>
                    )
                  }
                </div>
                <h3 class="font-code text-2xl font-semibold text-zinc-100 transition-colors group-hover:text-violet-300 sm:text-3xl">
                  {featuredProject.title}
                </h3>
              </div>

              {
                featuredProject.repository && (
                  <a
                    href={featuredProject.repository}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="icon-btn shrink-0"
                    aria-label={`Ver repositorio de ${featuredProject.title} en GitHub`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                      <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                  </a>
                )
              }
            </div>

            <p class="mb-6 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">
              {featuredProject.description}
            </p>

            <div class="mb-6 flex flex-wrap gap-2">
              {featuredProject.technologies.map((tech) => (
                <span class="tech-pill">{tech}</span>
              ))}
            </div>

            {
              featuredProject.repository && (
                <a
                  href={featuredProject.repository}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary text-xs sm:text-sm"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                  Ver en GitHub
                </a>
              )
            }
          </div>
        </article>
      )
    }

    <!-- Upcoming projects banner -->
    <div class="flex items-center gap-3 rounded-lg border border-dashed border-white/8 bg-zinc-900/30 px-5 py-4">
      <span class="font-code text-xs text-zinc-600">//</span>
      <p class="font-code text-xs text-zinc-500 sm:text-sm">
        Próximos proyectos en desarrollo...
      </p>
    </div>
  </div>
</section>
