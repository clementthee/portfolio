---
import { portfolioData } from '@/data/portfolioData';
import type { Certification } from '@/types/portfolio';

const { certifications } = portfolioData;

const issuerStyles: Record<string, string> = {
  Google: 'border-blue-500/25 bg-blue-500/10 text-blue-300',
  'Georgia Tech': 'border-yellow-500/25 bg-yellow-500/10 text-yellow-300',
  IBM: 'border-sky-500/25 bg-sky-500/10 text-sky-300',
  'EF SET': 'border-violet-500/25 bg-violet-500/10 text-violet-300',
};

function getIssuerStyle(issuer: string): string {
  return issuerStyles[issuer] ?? 'border-cyan-500/25 bg-cyan-500/10 text-cyan-300';
}

function isStandaloneCert(cert: Certification): boolean {
  return !cert.modules || cert.modules.length === 0;
}
---

<section id="certificaciones" class="mb-24 scroll-mt-24">
  <h2 class="section-heading">04 — Certificaciones</h2>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      certifications.filter(isStandaloneCert).map((cert) => (
        <article class="card-surface flex h-full flex-col p-5 sm:p-6">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class={`inline-flex rounded-full border px-2.5 py-0.5 font-mono text-xs ${getIssuerStyle(cert.issuer)}`}>
              {cert.issuer}
            </span>
            {
              cert.badge && (
                <span class="tech-pill border-violet-500/20 bg-violet-500/5 text-violet-300">
                  {cert.badge}
                </span>
              )
            }
          </div>

          <h3 class="mb-4 flex-1 text-base font-semibold leading-snug text-zinc-100 sm:text-lg">
            {cert.title}
          </h3>

          {
            cert.credentialUrl && (
              <a
                href={cert.credentialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary w-fit text-xs sm:text-sm"
              >
                Verify Credential ↗
              </a>
            )
          }
        </article>
      ))
    }
  </div>

  {
    certifications
      .filter((cert) => cert.modules && cert.modules.length > 0)
      .map((group) => (
        <div class="mt-6">
          <div class="mb-4 flex flex-wrap items-center gap-2">
            <span class={`inline-flex rounded-full border px-2.5 py-0.5 font-mono text-xs ${getIssuerStyle(group.issuer)}`}>
              {group.issuer}
            </span>
            {
              group.badge && (
                <span class="tech-pill">{group.badge}</span>
              )
            }
            <h3 class="font-code text-sm text-zinc-300">{group.title}</h3>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {group.modules!.map((module) => (
              <article class="card-surface flex flex-col gap-3 p-4 sm:p-5">
                <p class="text-sm leading-snug text-zinc-300">{module.title}</p>
                {
                  module.credentialUrl && (
                    <a
                      href={module.credentialUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-secondary w-fit text-xs"
                    >
                      Verify Credential ↗
                    </a>
                  )
                }
              </article>
            ))}
          </div>
        </div>
      ))
  }
</section>
