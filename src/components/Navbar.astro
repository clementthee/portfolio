---
import { portfolioData } from '@/data/portfolioData';

const { social } = portfolioData.personal;

const navLinks = [
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Habilidades', href: '#habilidades' },
  { label: 'Contacto', href: '#contacto' },
];
---

<nav
  class="sticky top-0 z-50 border-b border-white/5 bg-zinc-950/70 backdrop-blur-md"
  aria-label="Navegación principal"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <!-- Logo / Brand -->
    <a
      href="/"
      class="group flex items-center gap-1.5 font-code text-sm font-medium text-zinc-100 transition-colors hover:text-cyan-400"
      aria-label="Inicio — Hector Clemente"
    >
      <span class="text-cyan-500/70 transition-colors group-hover:text-cyan-400">&lt;</span>
      <span>HC</span>
      <span class="text-cyan-500/70 transition-colors group-hover:text-cyan-400"> /&gt;</span>
    </a>

    <!-- Desktop Nav Links -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      {
        social.github && (
          <a
            href={social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="GitHub"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
              ></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        )
      }

      {
        social.linkedin && (
          <a
            href={social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="LinkedIn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        )
      }

      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-md border border-cyan-500/30 bg-cyan-500/10 px-3 py-1.5 text-xs font-medium text-cyan-400 transition-all duration-200 hover:border-cyan-400/50 hover:bg-cyan-500/20 sm:text-sm"
        aria-label="Descargar CV"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" x2="12" y1="15" y2="3"></line>
        </svg>
        <span class="hidden sm:inline">CV</span>
      </a>
    </div>
  </div>

  <!-- Mobile Nav Links -->
  <div class="border-t border-white/5 md:hidden">
    <ul class="mx-auto flex max-w-5xl items-center justify-center gap-1 overflow-x-auto px-4 py-2 sm:px-6">
      {
        navLinks.map((link) => (
          <li class="shrink-0">
            <a href={link.href} class="nav-link whitespace-nowrap text-xs">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
