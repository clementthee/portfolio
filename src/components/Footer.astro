---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-6">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-4 text-center sm:flex-row sm:px-6 lg:px-8"
  >
    <p class="font-code text-xs text-zinc-500 sm:text-sm">
      &copy; {year} Hector Clemente. Built with Astro, React &amp; Tailwind CSS.
    </p>
    <p class="font-code text-xs text-emerald-500/80 sm:text-sm">
      🟢 All systems operational
    </p>
  </div>
</footer>
