---
import { portfolioData } from '@/data/portfolioData';

const { skills } = portfolioData;

const categoryIcons: Record<string, { icon: string; accent: string }> = {
  'Lenguajes': {
    accent: 'text-violet-400 bg-violet-500/10 border-violet-500/20',
    icon: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
  },
  'Backend & APIs': {
    accent: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20',
    icon: 'M4 7h16M4 12h16M4 17h10M8 7v10',
  },
  'Cloud & DevOps': {
    accent: 'text-sky-400 bg-sky-500/10 border-sky-500/20',
    icon: 'M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z',
  },
  'Bases de Datos': {
    accent: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20',
    icon: 'M12 2C8 2 4 3 4 6v12c0 3 4 4 8 4s8-1 8-4V6c0-3-4-4-8-4z M4 6c0 1.5 3 3 8 3s8-1.5 8-3 M4 12c0 1.5 3 3 8 3s8-1.5 8-3',
  },
};

function getCategoryMeta(category: string) {
  return (
    categoryIcons[category] ?? {
      accent: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20',
      icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',
    }
  );
}
---

<section id="habilidades" class="mb-24 scroll-mt-24">
  <h2 class="section-heading">03 — Habilidades</h2>

  <div class="grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2">
    {
      skills.map((group) => {
        const meta = getCategoryMeta(group.category);
        return (
          <article class="group card-surface hover:border-white/12 p-5 sm:p-6">
            <!-- Metric header -->
            <div class="mb-5 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div
                  class={`flex size-10 items-center justify-center rounded-lg border ${meta.accent}`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={meta.icon} />
                  </svg>
                </div>
                <div>
                  <h3 class="font-medium text-zinc-100">{group.category}</h3>
                  <p class="font-code text-xs text-zinc-600">
                    {group.skills.length} technologies
                  </p>
                </div>
              </div>
              <span class="font-code text-xs text-zinc-700 transition-colors group-hover:text-cyan-500/50">
                [{group.skills.length}]
              </span>
            </div>

            <!-- Skill badges -->
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="skill-badge">{skill}</span>
              ))}
            </div>
          </article>
        );
      })
    }
  </div>
</section>
